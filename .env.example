# ── Development (Vite dev proxy) ─────────────────────────────────────────────
# Where the Vite dev server forwards /api/* requests.
# Defaults to http://localhost:8081 when unset.
VITE_PROXY_TARGET=http://localhost:8081

# Alias for VITE_PROXY_TARGET (same purpose).
# VITE_ERPNEXT_URL=http://localhost:8081

# ── Production (Vercel serverless: api/proxy.ts + api/auth-login.ts) ─────────
# Required on Vercel → Project → Settings → Environment Variables
# (Production + Preview). NOT exposed to the browser.
#
# Must be a URL Vercel’s servers can reach (public IP/domain). Localhost and
# private LAN addresses will fail from Vercel with HTTP 502/500 on login.
ERPNEXT_URL=http://80.225.204.210:8090

# ERPNext API credentials — used by the serverless proxy for all /api/* data
# calls after login. NEVER prefix these with VITE_ in production if you can
# avoid it (VITE_ vars are bundled into the client).
ERP_API_KEY=
ERP_API_SECRET=

# Legacy aliases (used if ERP_* vars are unset):
# VITE_API_KEY=
# VITE_API_SECRET=

# ── Client-side (safe to prefix with VITE_) ──────────────────────────────────
# REQUIRED on every production/VM build. If omitted, the app falls back to
# "Netlink" (branding). Older builds fell back to "Inteva", which has no
# warehouses on this ERP site and caused:
#   "Warehouse is mandatory for stock Item …"
VITE_COMPANY=Netlink
VITE_DEFAULT_CURRENCY=USD
VITE_BUYING_PRICE_LIST=Standard Buying

# Anthropic Claude — browser-side only; do not use in public production.
VITE_ANTHROPIC_API_KEY=
# Anthropic model id. Optional — defaults to claude-sonnet-4-5-20250929.
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI — fallback when Claude is overloaded or unavailable.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# ── Role users (Netlink Procurement RBAC — provision with: node scripts/provision-role-users.mjs)
# procurement@netlink.com  → Procurement Manager
# finance@netlink.com      → Finance (payments, budget)
# warehouse@netlink.com    → Warehouse (GRN, invoices, inventory)
# department@netlink.com   → Department User (material requests)
# admin@netlink.com        → Full access
# Default password when provisioning: Netlink@2026 (override with ROLE_USER_PASSWORD)

# ── Demo MFA (development / staging / demo VM only) ─────────────────────────
# MUST be present at **build time** (`vite` / `vite build`). Runtime env in
# PM2/Docker/nginx does NOT enable Demo MFA in an already-built `dist/`.
#
# Localhost: set in gitignored `.env` (both lines recommended):
VITE_DEMO_MFA=true
DEMO_MFA=true
# APP_ENV=demo
#
# Demo VM / staging build (committed file — preferred on servers without .env):
#   npm run build:demo
#   # uses .env.demo → bakes OTP 121212 into the bundle
