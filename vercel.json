{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth-login?action=:action"
    },
    {
      "source": "/api/legal-review/(.*)",
      "destination": "/api/legal-review?action=$1"
    },
    {
      "source": "/api/bom/(.*)",
      "destination": "/api/bom?action=$1"
    },
    {
      "source": "/api/supplier-onboarding/(.*)",
      "destination": "/api/supplier-onboarding?action=$1"
    },
    {
      "source": "/api/po-shipment/(.*)",
      "destination": "/api/po-shipment?action=$1"
    },
    {
      "source": "/api/supplier-voucher/(.*)",
      "destination": "/api/supplier-voucher?action=$1"
    },
    {
      "source": "/api/stock-check",
      "destination": "/api/stock-check"
    },
    {
      "source": "/api/file-proxy",
      "destination": "/api/file-proxy"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],

  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  }
}