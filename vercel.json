{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth-login?action=:action"
    },
    {
      "source": "/api/legal-review/(.*)",
      "destination": "/api/legal-review?action=$1"
    },
    {
      "source": "/api/bom/(.*)",
      "destination": "/api/bom?action=$1"
    },
    {
      "source": "/api/supplier-onboarding/(.*)",
      "destination": "/api/supplier-onboarding?action=$1"
    },
    {
      "source": "/api/po-shipment/(.*)",
      "destination": "/api/po-shipment?action=$1"
    },
    {
      "source": "/api/supplier-voucher/(.*)",
      "destination": "/api/supplier-voucher?action=$1"
    },
    {
      "source": "/api/supplier-rfq-documents",
      "destination": "/api/supplier-rfq-documents"
    },
    {
      "source": "/api/stock-check",
      "destination": "/api/stock-check"
    },
    {
      "source": "/api/rfq-supplier-invite",
      "destination": "/api/rfq-supplier-invite"
    },
    {
      "source": "/api/rfq-quote-round",
      "destination": "/api/rfq-quote-round"
    },
    {
      "source": "/api/recommend-suppliers",
      "destination": "/api/recommend-suppliers"
    },
    {
      "source": "/api/reverse-bidding-naming",
      "destination": "/api/reverse-bidding-naming"
    },
    {
      "source": "/api/reverse-bidding-submit-item-bids",
      "destination": "/api/reverse-bidding-submit-item-bids"
    },
    {
      "source": "/api/file-proxy",
      "destination": "/api/file-proxy"
    },
    {
      "source": "/api/erp-server-date",
      "destination": "/api/erp-server-date"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],

  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  }
}