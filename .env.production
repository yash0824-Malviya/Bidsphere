# Loaded automatically by `vite build` (mode=production).
# Committed so the VM / nginx static deploy gets Demo MFA without a local .env.
#
# Demo MFA is a BUILD-TIME flag. Runtime PM2/Docker env cannot enable it
# after the bundle is already built.
#
# OTP: 121212

VITE_COMPANY=Netlink
VITE_DEMO_MFA=true
DEMO_MFA=true
APP_ENV=demo
